# Copy to .env and change secrets for real use
JWT_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://bi:bi@localhost:5432/platform
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESEND_MAX_PER_HOUR=5
UNVERIFIED_SOFT_DELETE_DAYS=7
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
FERNET_SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# Organizations are invite-only: a platform super admin creates orgs
# (python -m app.scripts.create_super_admin --email ... --password ...).
# Set true only for demos that want open self-signup.
ALLOW_PUBLIC_SIGNUP=false
# Base URL for invite links: <APP_BASE_URL>/accept-invite?token=...
APP_BASE_URL=http://localhost:3000
INVITE_EXPIRE_DAYS=7
REDIS_URL=redis://localhost:6379/0
SCHEMA_CACHE_TTL_SECONDS=3600
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Cheaper model for routing, narration and chat memory (empty = LLM_MODEL)
LLM_FAST_MODEL=
# USD per 1M tokens for per-user usage cost (llm_usage); 0 = tokens only
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0
EMBEDDING_PRICE_PER_MTOK=0
# development | test | production — production rejects EMBEDDING_PROVIDER=fake
APP_ENV=development
# Document RAG embeddings: fake (local/tests only) | openai (required in production)
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384
# Falls back to LLM_API_KEY when unset
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Fold chat memory in once a chat is quiet this long (one LLM call per burst)
MEMORY_UPDATE_DELAY_SECONDS=90
